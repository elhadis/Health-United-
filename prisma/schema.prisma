generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRATOR
  ADMIN
  USER
}

enum ProductCategory {
  HUMAN
  VETERINARY
}

enum UnitType {
  BOX
  CARTON
  BOTTLE
  INJECTABLE
  VIAL
  ML
  STRIP
}

enum OrderStatus {
  PENDING
  APPROVED
  DISPATCHED
  CONFIRMED
  REJECTED
}

enum OrderType {
  PHARMACY_TO_WAREHOUSE
  WAREHOUSE_TO_ADMIN
  PROCUREMENT
}

enum PaymentMethod {
  CASH
  BANK_APP
}

enum PaymentType {
  SALE
  SUPPLIER
  TRANSFER
}

model User {
  id           String     @id @default(cuid())
  name         String
  username     String     @unique
  email        String?    @unique
  passwordHash String
  role         Role       @default(USER)
  pharmacyId   String?
  warehouseId  String?
  pharmacy     Pharmacy?  @relation(fields: [pharmacyId], references: [id])
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id])
  sales        Sale[]
  orders       Order[]    @relation("OrderRequester")
  approvedOrders Order[]  @relation("OrderApprover")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([role])
}

model Warehouse {
  id        String       @id @default(cuid())
  name      String
  location  String?
  users     User[]
  batches   StockBatch[]
  orders    Order[]      @relation("WarehouseOrders")
  products  Product[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Pharmacy {
  id        String       @id @default(cuid())
  name      String
  location  String?
  users     User[]
  batches   StockBatch[]
  sales     Sale[]
  orders    Order[]      @relation("PharmacyOrders")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Product {
  id              String          @id @default(cuid())
  name            String
  sku             String?         @unique
  category        ProductCategory
  unitType        UnitType
  unitsPerBox     Int             @default(1)
  defaultPrice    Decimal         @db.Decimal(12, 2)
  costPrice       Decimal         @db.Decimal(12, 2)
  manufacturer    String?
  country         String?
  lowStockThreshold Int           @default(10)
  warehouseId     String?
  warehouse       Warehouse?      @relation(fields: [warehouseId], references: [id])
  batches         StockBatch[]
  orderItems      OrderItem[]
  saleItems       SaleItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([name])
  @@index([category])
}

model StockBatch {
  id            String     @id @default(cuid())
  productId     String
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNumber   String
  quantity      Int
  costPrice     Decimal    @db.Decimal(12, 2)
  expiryDate    DateTime
  warehouseId   String?
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])
  pharmacyId    String?
  pharmacy      Pharmacy?  @relation(fields: [pharmacyId], references: [id])
  manufacturer  String?
  country       String?
  receivedAt    DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  saleItems     SaleItem[]

  @@index([productId])
  @@index([expiryDate])
  @@index([batchNumber])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  type          OrderType
  status        OrderStatus @default(PENDING)
  notes         String?
  pharmacyId    String?
  pharmacy      Pharmacy?   @relation("PharmacyOrders", fields: [pharmacyId], references: [id])
  warehouseId   String?
  warehouse     Warehouse?  @relation("WarehouseOrders", fields: [warehouseId], references: [id])
  requesterId   String?
  requester     User?       @relation("OrderRequester", fields: [requesterId], references: [id])
  approverId    String?
  approver      User?       @relation("OrderApprover", fields: [approverId], references: [id])
  items         OrderItem[]
  approvedAt    DateTime?
  dispatchedAt  DateTime?
  confirmedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
  @@index([type])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitType  UnitType
  notes     String?
}

model Sale {
  id              String        @id @default(cuid())
  receiptNumber   String        @unique
  pharmacyId      String
  pharmacy        Pharmacy      @relation(fields: [pharmacyId], references: [id])
  cashierId       String?
  cashier         User?         @relation(fields: [cashierId], references: [id])
  paymentMethod   PaymentMethod
  bankAppName     String?
  transactionRef  String?
  subtotal        Decimal       @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  totalCost       Decimal       @db.Decimal(12, 2)
  profit          Decimal       @db.Decimal(12, 2)
  isOffline       Boolean       @default(false)
  syncedAt        DateTime?
  clientId        String?       @unique
  items           SaleItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([pharmacyId])
  @@index([createdAt])
  @@index([paymentMethod])
}

model SaleItem {
  id          String      @id @default(cuid())
  saleId      String
  sale        Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product     @relation(fields: [productId], references: [id])
  batchId     String?
  batch       StockBatch? @relation(fields: [batchId], references: [id])
  productName String
  quantity    Int
  unitType    UnitType
  unitPrice   Decimal     @db.Decimal(12, 2)
  costPrice   Decimal     @db.Decimal(12, 2)
  lineTotal   Decimal     @db.Decimal(12, 2)
  lineProfit  Decimal     @db.Decimal(12, 2)
}

model Supplier {
  id        String    @id @default(cuid())
  name      String
  country   String?
  phone     String?
  email     String?
  address   String?
  payments  Payment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Payment {
  id            String        @id @default(cuid())
  type          PaymentType
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  bankName      String?
  bankCountry   String?
  transactionRef String?
  notes         String?
  supplierId    String?
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])
  saleId        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([type])
  @@index([createdAt])
}
